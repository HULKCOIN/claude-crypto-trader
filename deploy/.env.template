# ============================================================
# HULKCOIN Crypto Trader — Environment-Variablen für Oracle VM
# ============================================================
# Datei liegt unter /opt/ccrypto-trader/.env
# Rechte: 600 (nur root lesbar) — WICHTIG, hier stehen Secrets drin!
#
# JEDE Zeile mit "TODO_" ersetzen durch deine echten Werte.
# Werte NICHT in Anführungszeichen setzen, kein Leerzeichen um =.

# ---- Telegram Trading-Bot (OWNER-ONLY Commands) ----
TELEGRAM_BOT_TOKEN=TODO_trading_bot_token
TELEGRAM_CHAT_ID=TODO_deine_private_chat_id
TELEGRAM_OWNER_CHAT_ID=TODO_deine_private_chat_id

# ---- Telegram News-Bot (öffentliche Gruppe) ----
TELEGRAM_NEWS_BOT_TOKEN=TODO_news_bot_token
TELEGRAM_NEWS_CHAT_ID=-1004382218113

# ---- Binance Demo-Mode (Paper-Trading, KEIN echtes Geld) ----
BINANCE_API_KEY=TODO_binance_demo_key
BINANCE_API_SECRET=TODO_binance_demo_secret

# ---- Market-Data APIs (frei) ----
ETHERSCAN_API_KEY=TODO_etherscan_key
COINGECKO_API_KEY=TODO_coingecko_key_optional

# ---- Gemini LLM (Review + News-Bot Q&A + Übersetzung) ----
GEMINI_API_KEY=TODO_gemini_key

# ---- Discord (optional, falls du Discord-Webhook nutzt) ----
DISCORD_WEBHOOK_URL=

# ---- Trading-Verhalten (fine-tuning) ----
# Edge-Threshold: 0.0 = break-even+ Trades, -1.0 = alles
MIN_EDGE_R=0.0
# ATR-Multiplikatoren für Stop/Target
STOP_ATR_MULT=2.5
TARGET_ATR_MULT=4.5
# Broker-Mode: paper | demo | testnet | live
BROKER_MODE_HINT=demo
