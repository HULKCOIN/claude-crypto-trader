{
  "universe": {
    "exchange": "coinbase",
    "quote": "USD",
    "top_n": 30,
    "min_volume_usd_24h": 5000000
  },
  "scanner": {
    "timeframe": "15m",
    "lookback_bars": 96,
    "setups": ["breakout", "flag", "oversold_bounce", "breakout_20d", "bull_flag", "reclaim_ma20", "oversold"],
    "min_atr_pct": 0.5,
    "_setup_options": "ours: breakout, flag, oversold_bounce | Jake's: breakout_20d, bull_flag, reclaim_ma20, oversold, oversold_bounce"
  },
  "timemachine": {
    "simulations": 10000,
    "history_days": 60,
    "session_bars": 24
  },
  "risk": {
    "max_daily_loss_pct": 2.0,
    "max_open_positions": 3,
    "max_correlation": 0.75,
    "flat_by_utc": null
  },
  "budget": {
    "account_equity_usd": 1000,
    "risk_per_trade_pct": 0.5,
    "sizing_method": "fixed_fractional"
  },
  "broker": {
    "exchange": "binance",
    "market": "spot",
    "_market_options": "spot | futures",
    "mode": "demo",
    "_mode_options": "paper (local sim) | demo (Binance Demo @ demo-api.binance.com, uses BINANCE_API_KEY/_SECRET) | testnet (testnet.binance.vision, separate _TESTNET_* keys) | live (REAL money)",
    "live_confirmed": false,
    "paper_balance_usd": 1000
  },
  "alerts": {
    "channels": ["stdout"],
    "telegram_bot_token_env": "TELEGRAM_BOT_TOKEN",
    "telegram_chat_id_env": "TELEGRAM_CHAT_ID",
    "discord_webhook_env": "DISCORD_WEBHOOK_URL"
  },
  "news": {
    "providers": ["coingecko-trending", "coindesk-rss", "cointelegraph-rss"],
    "_note": "all free, no API key required",
    "lookback_minutes": 60
  },
  "onchain": {
    "providers": ["blockchain.info", "etherscan"],
    "etherscan_api_key_env": "ETHERSCAN_API_KEY",
    "_note": "blockchain.info is keyless; etherscan free key at https://etherscan.io/myapikey (instant, no credit card)",
    "min_transfer_usd": 100000
  },
  "telegram": {
    "command_bot_enabled": true,
    "allowed_chat_ids_env": "TELEGRAM_CHAT_ID",
    "_note": "chat IDs allowed to issue /open /close /flat; use TELEGRAM_CHAT_ID (same as alert target)"
  },
  "sentiment": {
    "fear_greed_endpoint": "https://api.alternative.me/fng/"
  }
}
